{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project.schema.json",
  "title": "Projects data file (src/data/projects.json)",
  "type": "array",
  "minItems": 1,
  "items": { "$ref": "#/$defs/project" },
  "$defs": {
    "localizedString": {
      "type": "object",
      "required": ["en", "pl"],
      "additionalProperties": false,
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "pl": { "type": "string", "minLength": 1 }
      }
    },
    "localizedStringList": {
      "type": "object",
      "required": ["en", "pl"],
      "additionalProperties": false,
      "properties": {
        "en": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "pl": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "$comment": "en and pl arrays MUST have equal length (enforced in the Zod schema refine)."
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "slug", "title", "description", "technologies", "domain",
        "platform", "type", "status", "achievements", "image", "github", "demo"
      ],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "$ref": "#/$defs/localizedString" },
        "technologies": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "domain": { "type": "string", "minLength": 1 },
        "platform": { "enum": ["Web", "Mobile", "Desktop", "AI/Automation"] },
        "type": { "enum": ["personal", "client"] },
        "status": { "enum": ["completed", "in-progress"] },
        "achievements": { "$ref": "#/$defs/localizedStringList" },
        "image": {
          "type": ["string", "null"],
          "pattern": "^\\.\\./assets/projects/[a-z0-9-]+\\.(png|jpg|jpeg|webp|avif)$",
          "$comment": "Relative to src/data/projects.json; resolved by astro:assets."
        },
        "imageAlt": { "$ref": "#/$defs/localizedString" },
        "github": { "type": ["string", "null"], "format": "uri" },
        "demo": { "type": ["string", "null"], "format": "uri" }
      },
      "if": { "properties": { "image": { "type": "string" } } },
      "then": { "required": ["imageAlt"] }
    }
  }
}
