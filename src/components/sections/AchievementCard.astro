---
// Port of achievement_card() + project_info_box() from portfolio/case_studies.py.
import {
  ArrowDown,
  ArrowRight,
  Briefcase,
  CircleAlert,
  CircleCheck,
  ExternalLink,
  Lightbulb,
  Sparkles,
} from '@lucide/astro';
import T from '../T.astro';
import type { achievements } from '../../lib/content';
import { url } from '../../lib/url';

interface Props {
  item: (typeof achievements)[number];
  /** 1-based position, shown as the large case number. */
  index: number;
}
const { item, index } = Astro.props;
---

<article class={`case c-${item.color}`} data-reveal>
  <span class="number" aria-hidden="true">
    {String(index).padStart(2, '0')}
  </span>

  {item.projectTitle ? (
    <header class="head">
      <span class="label small">
        <Briefcase size={14} aria-hidden="true" />
        <T k="case_project_label" />
      </span>
      <a class="project" href={url('projects/')}>
        {item.projectTitle}
        <ExternalLink size={14} aria-hidden="true" />
      </a>
    </header>
  ) : (
    item.titleKey && (
      <header class="head">
        <span class="label small">
          <Sparkles size={14} aria-hidden="true" />
          <T k="case_area_label" />
        </span>
        <span class="project">
          <T k={item.titleKey} />
        </span>
      </header>
    )
  )}

  <div class="flow">
    <div class="block problem">
      <p class="label">
        <CircleAlert size={18} aria-hidden="true" />
        <T k="achievements_problem" />
      </p>
      <T k={item.problemKey} as="p" class="problem-text" />
    </div>
    <span class="arrow" aria-hidden="true">
      <ArrowRight size={22} class="arrow-row" />
      <ArrowDown size={22} class="arrow-col" />
    </span>
    <div class="block solution">
      <p class="label">
        <Lightbulb size={18} aria-hidden="true" />
        <T k="achievements_solution" />
      </p>
      <T k={item.solutionKey} as="p" class="solution-text" />
    </div>
  </div>

  <p class="result">
    <span class="result-icon">
      <CircleCheck size={22} aria-hidden="true" />
    </span>
    <span class="result-body">
      <span class="label small">
        <T k="achievements_result" />
      </span>
      <T k={item.resultKey} class="result-text" />
    </span>
  </p>
</article>

<style>
  .case {
    --tint: color-mix(in srgb, rgb(var(--c)) 60%, white);
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
    max-width: 1100px;
    margin: 0 auto 2.5rem;
    padding: 1.25rem 1rem;
    overflow: hidden;
    border: 1px solid transparent;
    border-radius: 1.5rem;
    /* Glow in the case colour over a dark fill, framed by a gradient border. */
    background:
      radial-gradient(circle at 0% 0%, rgba(var(--c), 0.18), transparent 55%) padding-box,
      radial-gradient(circle at 100% 100%, rgba(var(--c), 0.1), transparent 50%) padding-box,
      linear-gradient(rgba(12, 14, 32, 0.92), rgba(12, 14, 32, 0.92)) padding-box,
      linear-gradient(135deg, rgba(var(--c), 0.7), rgba(var(--c), 0.05) 45%, rgba(var(--c), 0.45))
        border-box;
    box-shadow: 0 20px 50px -20px rgba(var(--c), 0.25);
    transition:
      transform 0.35s ease,
      box-shadow 0.35s ease;
  }
  @media (min-width: 768px) {
    .case {
      padding: 2.25rem 2.5rem;
    }
  }
  .case:hover {
    transform: translateY(-6px);
    box-shadow: 0 28px 60px -18px rgba(var(--c), 0.4);
  }

  .number {
    position: absolute;
    top: 0.5rem;
    right: 1.25rem;
    color: transparent;
    font-size: clamp(3.5rem, 10vw, 6rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.05em;
    -webkit-text-stroke: 1.5px rgba(var(--c), 0.45);
    pointer-events: none;
    user-select: none;
  }

  .label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--tint);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .small {
    font-size: 0.7rem;
    letter-spacing: 0.12em;
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-right: 5rem;
  }
  .project {
    color: #fff;
    font-size: clamp(1.2rem, 3vw, 1.5rem);
    font-weight: 800;
    line-height: 1.3;
    text-decoration: none;
  }
  .project :global(svg) {
    display: inline-block;
    margin-left: 0.35rem;
    vertical-align: -0.05em;
    color: var(--tint);
    transition: transform 0.25s ease;
  }
  .project:hover {
    color: var(--tint);
  }
  .project:hover :global(svg) {
    transform: translate(2px, -2px);
  }

  .flow {
    display: grid;
    gap: 0.75rem;
  }
  @media (min-width: 900px) {
    .flow {
      grid-template-columns: 1fr auto 1.4fr;
      align-items: stretch;
    }
  }
  .block {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1rem;
    border-radius: var(--radius-lg);
  }
  @media (min-width: 768px) {
    .block {
      padding: 1.25rem;
    }
  }
  .problem {
    border: 1px solid rgba(255, 255, 255, 0.06);
    background: rgba(255, 255, 255, 0.03);
  }
  .solution {
    border: 1px solid rgba(var(--c), 0.25);
    background: rgba(var(--c), 0.07);
  }
  .block :global(.problem-text) {
    color: var(--gray-200);
    font-weight: 500;
    line-height: 1.6;
  }
  .block :global(.solution-text) {
    color: var(--gray-300);
    font-size: 0.95rem;
    line-height: 1.7;
  }
  .arrow {
    display: grid;
    place-items: center;
    align-self: center;
    justify-self: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: rgba(var(--c), 0.15);
    color: var(--tint);
  }
  .arrow :global(.arrow-row) {
    display: none;
  }
  @media (min-width: 900px) {
    .arrow :global(.arrow-row) {
      display: block;
    }
    .arrow :global(.arrow-col) {
      display: none;
    }
  }

  .result {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border: 1px solid rgba(var(--c), 0.35);
    border-radius: var(--radius-lg);
    background: linear-gradient(90deg, rgba(var(--c), 0.22), rgba(var(--c), 0.04));
  }
  .result-icon {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: rgba(var(--c), 0.2);
    box-shadow: 0 0 24px rgba(var(--c), 0.45);
    color: var(--tint);
  }
  .result-body {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .result :global(.result-text) {
    color: #fff;
    font-size: clamp(1.05rem, 2.5vw, 1.25rem);
    font-weight: 700;
    line-height: 1.35;
  }
</style>
