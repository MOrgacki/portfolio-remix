---
// Port of achievement_card() + project_info_box() from portfolio/case_studies.py.
import { Briefcase, CircleAlert, CircleCheck, ExternalLink, Lightbulb } from '@lucide/astro';
import T from '../T.astro';
import type { achievements } from '../../lib/content';
import { url } from '../../lib/url';

interface Props {
  item: (typeof achievements)[number];
}
const { item } = Astro.props;
---

<article class={`case c-${item.color}`} data-reveal>
  <div class="card">
    <div class="block">
      <p class="label">
        <CircleAlert size={20} aria-hidden="true" />
        <T k="achievements_problem" />
      </p>
      <T k={item.problemKey} as="p" class="problem" />
    </div>
    <hr />
    <div class="block">
      <p class="label">
        <Lightbulb size={20} aria-hidden="true" />
        <T k="achievements_solution" />
      </p>
      <T k={item.solutionKey} as="p" class="solution" />
    </div>
    <p class="result">
      <CircleCheck size={18} aria-hidden="true" />
      <span class="label-inline">
        <T k="achievements_result" />:
      </span>
      <T k={item.resultKey} class="result-text" />
    </p>
  </div>
  {item.projectTitle && (
    <aside class="project">
      <p class="label small">
        <Briefcase size={16} aria-hidden="true" />
        <T k="case_project_label" />
      </p>
      <p class="project-title">{item.projectTitle}</p>
      <a href={url('projects/')}>
        <T k="case_view_project" />
        <ExternalLink size={12} aria-hidden="true" />
      </a>
    </aside>
  )}
</article>

<style>
  .case {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
    max-width: 1100px;
    margin: 0 auto 2rem;
    --tint: color-mix(in srgb, rgb(var(--c)) 60%, white);
  }
  @media (min-width: 900px) {
    .case {
      flex-direction: row;
      align-items: flex-start;
    }
  }
  .card {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.5rem;
    border: 1px solid rgba(var(--c), 0.2);
    border-radius: var(--radius-lg);
    background: rgba(var(--c), 0.05);
    backdrop-filter: blur(10px);
    transition: var(--transition);
  }
  @media (min-width: 768px) {
    .card {
      padding: 2rem;
    }
  }
  .card:hover {
    background: rgba(var(--c), 0.08);
    border-color: rgba(var(--c), 0.4);
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(var(--c), 0.2);
  }
  .block {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .label,
  .label-inline {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--tint);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .card :global(.problem) {
    color: var(--gray-300);
    font-weight: 500;
  }
  .card :global(.solution) {
    color: var(--gray-400);
    font-size: 0.95rem;
    line-height: 1.7;
  }
  hr {
    border: 0;
    border-top: 1px solid rgba(var(--c), 0.2);
  }
  .result {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    max-width: 100%;
    padding: 0.75rem 1.25rem;
    border: 1px solid rgba(var(--c), 0.4);
    border-radius: var(--radius-full);
    background: rgba(var(--c), 0.12);
    color: var(--tint);
  }
  .result :global(.result-text) {
    font-weight: 600;
  }
  .project {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 1.25rem;
    border: 2px solid rgba(var(--c), 0.2);
    border-radius: var(--radius-lg);
    background: rgba(var(--c), 0.05);
    text-align: center;
  }
  @media (min-width: 900px) {
    .project {
      width: 220px;
    }
  }
  .small {
    font-size: 0.7rem;
    letter-spacing: 0.1em;
  }
  .project-title {
    color: var(--gray-200);
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.4;
  }
  .project a {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--tint);
    font-size: 0.85rem;
    font-weight: 600;
  }
</style>
