---
// Port of contact_section() from portfolio/main.py (shown on Experience and Contact).
import T from '../T.astro';
import SocialLinks from '../SocialLinks.astro';

interface Props {
  /** Render the heading as the page's h1 (Contact page) instead of h2. */
  primary?: boolean;
}
const { primary = false } = Astro.props;
---

<section class="contact" id="contact">
  <T k="contact_title" as={primary ? 'h1' : 'h2'} class="contact-title gradient-text" />
  <T k="contact_description" as="p" class="contact-text" />
  <SocialLinks />
  <slot />
</section>

<style>
  .contact {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    width: 100%;
    padding: 4rem 1.25rem;
    background: var(--surface);
    backdrop-filter: blur(10px);
    text-align: center;
  }
  .contact :global(.contact-title) {
    background: var(--accent-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    font-size: clamp(1.8rem, 5vw, 2.5rem);
    font-weight: 700;
  }
  .contact :global(.contact-text) {
    max-width: 600px;
    margin-bottom: 1rem;
    color: var(--gray-300);
    font-size: 1.1rem;
  }
</style>
