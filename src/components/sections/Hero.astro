---
// Port of the name/social block of Main.build_view() in portfolio/main.py.
import T from '../T.astro';
import SocialLinks from '../SocialLinks.astro';
---

<section class="hero">
  <h1 class="name">
    <span class="greeting">
      <T k="home_hello" /> <T k="home_im" />
    </span>
    <span class="gradient">Marcin Orgacki</span>
    <span class="wave" aria-hidden="true">
      👋
    </span>
  </h1>
  <SocialLinks />
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    text-align: center;
  }
  .name {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.25rem 1rem;
    font-size: clamp(2.25rem, 7vw, 4rem);
    font-weight: 700;
    line-height: 1.2;
  }
  .greeting {
    color: var(--gray-100);
    font-size: 0.85em;
    font-weight: 600;
  }
  .gradient {
    background: var(--accent-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    padding-bottom: 0.1rem;
  }
  .wave {
    display: inline-block;
    font-size: 0.85em;
    transform-origin: 70% 70%;
    animation: wave 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94) infinite alternate-reverse both;
  }
  @keyframes wave {
    from {
      transform: rotate(25deg);
    }
    to {
      transform: rotate(-15deg);
    }
  }
</style>
