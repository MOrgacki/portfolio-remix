---
// Port of portfolio/header.py (desktop nav + mobile drawer).
import { Image } from 'astro:assets';
import { Briefcase, Trophy, SquareLibrary, Mail, House, Menu, X } from '@lucide/astro';
import T from './T.astro';
import profile from '../assets/profile.png';
import { both } from '../i18n';
import { url } from '../lib/url';
import type { NavKey } from '../lib/nav';

interface Props {
  current?: NavKey;
}
const { current } = Astro.props;

const items = [
  { key: 'home', label: 'nav_home', href: '', icon: House },
  { key: 'experience', label: 'nav_experience', href: 'experience/', icon: Briefcase },
  { key: 'case_studies', label: 'nav_case_studies', href: 'case-studies/', icon: Trophy },
  { key: 'projects', label: 'nav_projects', href: 'projects/', icon: SquareLibrary },
  { key: 'contact', label: 'nav_contact', href: 'contact/', icon: Mail },
] as const;
const openLabel = both('menu_open');
const closeLabel = both('menu_close');
---

<header class="header">
  <a class="logo" href={url('')}>
    <Image src={profile} alt="Marcin Orgacki" width={65} height={35} loading="eager" />
  </a>

  <nav class="nav-desktop" aria-label="Main">
    <ul role="list">
      {items.map(({ key, label, href, icon: Icon }) => (
        <li>
          <a href={url(href)} aria-current={current === key ? 'page' : undefined}>
            <Icon size={16} aria-hidden="true" />
            <T k={label} />
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <button
    type="button"
    class="menu-button"
    aria-expanded="false"
    aria-controls="mobile-menu"
    aria-label={openLabel.en}
    data-i18n-aria-label-en={openLabel.en}
    data-i18n-aria-label-pl={openLabel.pl}
    data-menu-open
  >
    <Menu size={26} aria-hidden="true" />
  </button>

  <div class="drawer" id="mobile-menu" hidden data-menu>
    <button
      type="button"
      class="menu-close"
      aria-label={closeLabel.en}
      data-i18n-aria-label-en={closeLabel.en}
      data-i18n-aria-label-pl={closeLabel.pl}
      data-menu-close
    >
      <X size={30} aria-hidden="true" />
    </button>
    <nav aria-label="Mobile">
      <ul role="list">
        {items.map(({ key, label, href, icon: Icon }) => (
          <li>
            <a href={url(href)} aria-current={current === key ? 'page' : undefined}>
              <Icon size={20} aria-hidden="true" />
              <T k={label} />
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  import '../scripts/menu';
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 1rem;
    background: var(--surface-header);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border);
  }
  @media (min-width: 768px) {
    .header {
      padding: 0.75rem 2rem;
    }
  }
  .logo img {
    width: 65px;
    height: 35px;
    object-fit: contain;
  }
  .nav-desktop {
    display: none;
    align-items: center;
    gap: 0.5rem;
  }
  .nav-desktop ul {
    display: flex;
    gap: 0.25rem;
  }
  a[aria-current='page'] {
    background: rgba(0, 212, 255, 0.12);
    color: var(--accent-text);
  }
  .nav-desktop a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 0.75rem;
    border-radius: 0.25rem;
    color: #fff;
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .nav-desktop a:hover {
    background: rgba(0, 212, 255, 0.1);
    color: var(--accent-text);
    transform: translateY(-1px);
    box-shadow: 0 4px 20px rgba(0, 212, 255, 0.2);
  }
  .menu-button,
  .menu-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    background: none;
    border: 0;
    color: #fff;
    cursor: pointer;
  }
  .drawer {
    position: fixed;
    inset: 0 0 0 auto;
    z-index: 200;
    width: min(280px, 85vw);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    background: rgba(15, 15, 35, 0.97);
    backdrop-filter: blur(20px);
    border-left: 1px solid var(--border);
  }
  .drawer[hidden] {
    display: none;
  }
  .menu-close {
    align-self: flex-end;
    margin-bottom: 2rem;
  }
  .drawer ul {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .drawer a {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    min-height: 60px;
    padding: 1rem 2rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius);
    color: #fff;
    font-size: 1.1rem;
    font-weight: 500;
    text-decoration: none;
  }
  .drawer a:hover {
    background: rgba(0, 212, 255, 0.1);
    color: var(--accent-text);
  }
  @media (min-width: 1024px) {
    .nav-desktop {
      display: flex;
    }
    .menu-button,
    .drawer {
      display: none !important;
    }
  }
</style>
