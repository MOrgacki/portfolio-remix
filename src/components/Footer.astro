---
// The legacy footer (portfolio/footer.py) is intentionally empty; keep a minimal attribution.
const year = new Date().getFullYear();
---

<footer class="footer">
  <p>© 2018-{year} Marcin Orgacki</p>
</footer>

<style>
  .footer {
    position: relative;
    z-index: 10;
    display: flex;
    justify-content: center;
    padding: 1.5rem 1rem 5.5rem;
    color: var(--gray-400);
    font-size: 0.85rem;
  }
  @media (max-width: 767px) {
    .footer {
      font-size: 0.65rem;
    }
  }
</style>
