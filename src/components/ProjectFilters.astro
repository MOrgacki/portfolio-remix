---
// Port of filter_section() from portfolio/projects.py using native form controls.
// Technologies: multi-select (match ANY); type, platform, domain: single select; all combined with AND.
import { Search, X } from '@lucide/astro';
import T from './T.astro';
import { both } from '../i18n';
import {
  domainGroups,
  domainLabels,
  platformLabels,
  techGroups,
  type Project,
} from '../lib/projects';

interface Props {
  projects: Project[];
}
const { projects } = Astro.props;
const groups = techGroups(projects);
const domains = domainGroups(projects);
const placeholder = both('proj_search');
const types = [
  { value: 'all', key: 'proj_all' },
  { value: 'personal', key: 'proj_personal' },
  { value: 'client', key: 'proj_client' },
] as const;
---

<form class="filters" data-filters role="search" onsubmit="return false">
  <fieldset class="types">
    <legend class="visually-hidden">
      <T k="proj_title" />
    </legend>
    {types.map((t) => (
      <label class="type-pill">
        <input type="radio" name="type" value={t.value} checked={t.value === 'all'} />
        <T k={t.key} />
      </label>
    ))}
  </fieldset>

  <div class="panel filter-panel">
    <label class="search">
      <Search size={17} aria-hidden="true" />
      <span class="visually-hidden">
        <T k="proj_search" />
      </span>
      <input
        type="search"
        name="q"
        autocomplete="off"
        placeholder={placeholder.en}
        data-i18n-placeholder-en={placeholder.en}
        data-i18n-placeholder-pl={placeholder.pl}
      />
    </label>

    <div class="columns">
      <fieldset class="techs">
        <legend class="group-title">
          <T k="proj_technologies" />
        </legend>
        {groups.map((g) => (
          <div class="tech-row" style={`--c: var(${g.colorToken})`}>
            <span class="category">
              <T en={g.label.en} pl={g.label.pl} />
            </span>
            {g.popular.map((tech) => (
              <label class="chip">
                <input type="checkbox" name="tech" value={tech} />
                {tech}
              </label>
            ))}
            {g.rest.length > 0 && (
              <details class="more">
                <summary>+{g.rest.length}</summary>
                <div class="more-items">
                  {g.rest.map((tech) => (
                    <label class="chip">
                      <input type="checkbox" name="tech" value={tech} />
                      {tech}
                    </label>
                  ))}
                </div>
              </details>
            )}
          </div>
        ))}
      </fieldset>

      <div class="side">
        <fieldset>
          <legend class="group-title">
            <T k="proj_platform" />
          </legend>
          <div class="pills">
            <label class="pill">
              <input type="radio" name="platform" value="all" checked />
              <T k="proj_all" />
            </label>
            {Object.entries(platformLabels).map(([value, label]) => (
              <label class="pill">
                <input type="radio" name="platform" value={value} />
                <T en={label.en} pl={label.pl} />
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset>
          <legend class="group-title">
            <T k="proj_domain" />
          </legend>
          <div class="pills">
            <label class="pill">
              <input type="radio" name="domain" value="all" checked />
              <T k="proj_all" />
            </label>
            {domains.popular.map((value) => (
              <label class="pill">
                <input type="radio" name="domain" value={value} />
                <T en={domainLabels[value].en} pl={domainLabels[value].pl} />
              </label>
            ))}
          </div>
          {domains.rest.length > 0 && (
            <details class="more">
              <summary>+{domains.rest.length}</summary>
              <div class="pills more-items">
                {domains.rest.map((value) => (
                  <label class="pill">
                    <input type="radio" name="domain" value={value} />
                    <T en={domainLabels[value].en} pl={domainLabels[value].pl} />
                  </label>
                ))}
              </div>
            </details>
          )}
        </fieldset>

        <button type="reset" class="clear">
          <X size={13} aria-hidden="true" />
          <T k="proj_clear_filters" />
        </button>
      </div>
    </div>
  </div>
</form>

<style>
  .filters {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }
  fieldset {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }
  input[type='radio'],
  input[type='checkbox'] {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }
  label:has(input:focus-visible) {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }
  .types {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }
  .type-pill {
    position: relative;
    padding: 0.6rem 1.4rem;
    border: 2px solid rgba(100, 116, 139, 0.3);
    border-radius: 1.5rem;
    background: rgba(30, 41, 59, 0.6);
    color: var(--gray-300);
    font-weight: 700;
    cursor: pointer;
    transition: var(--transition);
  }
  .type-pill:has(input:checked) {
    border-color: rgba(0, 212, 255, 0.8);
    background: var(--accent-gradient);
    color: #04121c;
    box-shadow: 0 8px 20px rgba(0, 212, 255, 0.3);
  }
  .filter-panel {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.25rem;
    background: rgba(15, 23, 42, 0.6);
  }
  .search {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: rgba(30, 41, 59, 0.4);
    color: var(--gray-400);
  }
  .search:focus-within {
    border-color: rgba(0, 212, 255, 0.5);
  }
  .search input {
    flex: 1;
    min-width: 0;
    padding: 0.25rem 0;
    border: 0;
    background: transparent;
    color: #fff;
    outline: none;
  }
  .columns {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 900px) {
    .columns {
      grid-template-columns: 1.4fr 1fr;
      gap: 2rem;
    }
  }
  .group-title {
    margin-bottom: 0.5rem;
    color: var(--gray-300);
    font-size: 0.9rem;
    font-weight: 700;
  }
  .tech-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    margin-bottom: 0.5rem;
  }
  .category {
    padding: 0.1rem 0.45rem;
    border: 1px solid rgba(var(--c), 0.28);
    border-radius: 0.3rem;
    background: rgba(var(--c), 0.12);
    color: color-mix(in srgb, rgb(var(--c)) 60%, white);
    font-size: 0.68rem;
    font-weight: 700;
    white-space: nowrap;
  }
  .chip {
    position: relative;
    padding: 0.2rem 0.6rem;
    border: 1px solid rgba(var(--c), 0.25);
    border-radius: 0.5rem;
    background: rgba(var(--c), 0.05);
    color: color-mix(in srgb, rgb(var(--c)) 45%, white);
    font-size: 0.78rem;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .chip:has(input:checked) {
    border-color: rgba(var(--c), 0.7);
    background: rgba(var(--c), 0.3);
    color: #fff;
  }
  .more {
    display: contents;
  }
  .more summary {
    display: inline-block;
    width: fit-content;
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 0.4rem;
    background: rgba(30, 41, 59, 0.3);
    color: var(--gray-400);
    font-size: 0.75rem;
    cursor: pointer;
    list-style: none;
  }
  .more summary::-webkit-details-marker {
    display: none;
  }
  /* Once expanded, the whole group is visible, so the "+N" toggle has nothing left to add. */
  .more[open] summary {
    display: none;
  }
  .more-items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    width: 100%;
    padding-top: 0.25rem;
  }
  .side {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .pill {
    position: relative;
    padding: 0.25rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    background: rgba(30, 41, 59, 0.4);
    color: var(--gray-300);
    font-size: 0.8rem;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .pill:has(input:checked) {
    border-color: rgba(139, 92, 246, 0.6);
    background: linear-gradient(135deg, #7c3aed, #a855f7);
    color: #fff;
  }
  .clear {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    align-self: flex-start;
    min-height: 36px;
    padding: 0.35rem 0.9rem;
    border: 1px solid rgba(239, 68, 68, 0.3);
    border-radius: 0.6rem;
    background: rgba(239, 68, 68, 0.09);
    color: #fca5a5;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
  }
  .clear:hover {
    background: rgba(239, 68, 68, 0.18);
  }
</style>
