---
// Port of language_switcher() (header.py) and floating_language_button() (floating_button.py).
// Shows the active language code; the accessible name starts with it and names the target language.
import { Globe } from '@lucide/astro';
import T from './T.astro';

interface Props {
  floating?: boolean;
}
const { floating = false } = Astro.props;
---

<button type="button" class:list={['lang-button', { floating }]} data-lang-toggle>
  <Globe size={floating ? 20 : 16} aria-hidden="true" />
  <span lang="en">EN</span>
  <span lang="pl">PL</span>
  <span class="visually-hidden">
    – <T k="lang_switch_label" />
  </span>
</button>

<style>
  .lang-button {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 40px;
    padding: 0.5rem 0.75rem;
    border: 1px solid rgba(0, 212, 255, 0.3);
    border-radius: var(--radius-sm);
    background: rgba(0, 212, 255, 0.1);
    color: #fff;
    font-weight: 700;
    font-size: 0.9rem;
    cursor: pointer;
    transition: var(--transition);
  }
  .lang-button:hover {
    background: rgba(0, 212, 255, 0.2);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(0, 212, 255, 0.3);
  }
  .floating {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 1000;
    min-height: 48px;
    padding: 0.75rem 1rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50px;
    background: linear-gradient(135deg, rgba(0, 150, 190, 0.95) 0%, rgba(70, 90, 220, 0.95) 100%);
    box-shadow: 0 8px 32px rgba(0, 212, 255, 0.4);
    font-size: 1rem;
  }
  .floating:hover {
    transform: translateY(-3px) scale(1.05);
    box-shadow: 0 12px 40px rgba(0, 212, 255, 0.6);
  }
  @media (min-width: 768px) {
    .floating {
      right: 2rem;
      bottom: 2rem;
    }
  }
</style>
