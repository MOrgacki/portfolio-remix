---
import { getImage } from 'astro:assets';
import '../styles/global.css';
import AnimatedBackground from '../components/AnimatedBackground.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LanguageButton from '../components/LanguageButton.astro';
import T from '../components/T.astro';
import profile from '../assets/profile.png';
import { t, type TKey } from '../i18n';
import { url } from '../lib/url';

import type { NavKey } from '../lib/nav';

interface Props {
  titleKey: TKey;
  descriptionKey: TKey;
  nav?: NavKey;
}

const { titleKey, descriptionKey, nav } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = await getImage({ src: profile, format: 'png', width: 600 });
---

<!doctype html>
<html lang="en" data-lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Resolve the language before first paint so Polish visitors never see English (contracts/i18n.md). -->
    <script is:inline>
      (function () {
        var lang = null;
        try {
          lang = localStorage.getItem('portfolio.lang');
        } catch (e) {}
        if (lang !== 'en' && lang !== 'pl') {
          var nav = (navigator.languages && navigator.languages[0]) || navigator.language || '';
          lang = nav.toLowerCase().indexOf('pl') === 0 ? 'pl' : 'en';
        }
        document.documentElement.dataset.lang = lang;
        document.documentElement.lang = lang;
        if (
          'IntersectionObserver' in window &&
          !matchMedia('(prefers-reduced-motion: reduce)').matches
        )
          document.documentElement.classList.add('reveal-on');
        document.documentElement.classList.add('is-loading');
      })();
    </script>
    <!-- Loading bar + scroll reveal. Inline in <head> so elements are revealed while the HTML
         is still streaming in; waiting for a bundle or the end of a large page leaves it blank. -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        addEventListener('load', function () {
          root.classList.remove('is-loading');
        });

        // Fades [data-reveal] elements in as they scroll into view (styles in global.css).
        if (!root.classList.contains('reveal-on')) return;
        var pending = [];
        var queued = false;
        // Reveal everything that has reached the viewport or was scrolled past (fast scrolls
        // and anchor jumps can skip an element entirely), including off-screen timeline steps.
        var reveal = function () {
          queued = false;
          var batch = 0;
          pending = pending.filter(function (el) {
            var rect = el.getBoundingClientRect();
            if (rect.height === 0 || rect.top > innerHeight * 0.95) return true; // hidden by a filter or still below
            // Stagger elements that appear together (e.g. a row of cards), capped so none waits long.
            el.style.setProperty('--reveal-delay', Math.min(batch++, 5) * 90 + 'ms');
            el.classList.add('is-revealed');
            observer.unobserve(el);
            return false;
          });
        };
        var schedule = function () {
          if (queued) return;
          queued = true;
          requestAnimationFrame(reveal);
        };
        // Also catches project cards that become visible again after filtering, without a scroll.
        var observer = new IntersectionObserver(schedule);
        var track = function (el) {
          if (el.revealTracked) return;
          el.revealTracked = true;
          pending.push(el);
          observer.observe(el);
        };
        var scan = function (node) {
          if (node.nodeType !== 1) return;
          if (node.hasAttribute('data-reveal')) track(node);
          node.querySelectorAll('[data-reveal]').forEach(track);
        };
        var parsing = new MutationObserver(function (mutations) {
          mutations.forEach(function (m) {
            m.addedNodes.forEach(scan);
          });
          schedule();
        });
        parsing.observe(root, { childList: true, subtree: true });
        document.addEventListener('DOMContentLoaded', function () {
          parsing.disconnect();
          scan(document.body);
          schedule();
        });
        addEventListener('scroll', schedule, { passive: true });
        addEventListener('resize', schedule);
      })();
    </script>
    <title>{t(titleKey, 'en')}</title>
    <meta name="i18n-title-pl" content={t(titleKey, 'pl')} />
    <meta name="description" content={t(descriptionKey, 'en')} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('favicon.ico')} sizes="any" />
    <meta name="theme-color" content="#0f0f23" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={t(titleKey, 'en')} />
    <meta property="og:description" content={t(descriptionKey, 'en')} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage.src, Astro.site)} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <div class="page-loader" aria-hidden="true"></div>
    <a class="skip-link" href="#main">
      <T k="skip_to_content" />
    </a>
    <AnimatedBackground />
    <div class="shell">
      <Header current={nav} />
      <main id="main" tabindex="-1">
        <slot />
      </main>
      <Footer />
    </div>
    <LanguageButton floating />
    <script>
      import '../scripts/lang';
    </script>
  </body>
</html>

<style>
  .shell {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }
  main {
    flex: 1;
    outline: none;
  }
</style>
