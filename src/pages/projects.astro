---
import BaseLayout from '../layouts/BaseLayout.astro';
import T from '../components/T.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectFilters from '../components/ProjectFilters.astro';
import ProjectDialog from '../components/ProjectDialog.astro';
import GetInTouch from '../components/sections/GetInTouch.astro';
import { loadProjects } from '../lib/projects';
import { t } from '../i18n';

const projects = await loadProjects();

// proj_description has a {count} placeholder filled with the number of listed projects;
// Polish also needs the matching noun form (2-4 → "projekty", otherwise "projektów").
const count = projects.length;
const plNoun =
  count % 10 >= 2 && count % 10 <= 4 && !(count % 100 >= 12 && count % 100 <= 14)
    ? 'projekty'
    : 'projektów';
const lead = {
  en: t('proj_description', 'en').replace('{count}', String(count)),
  pl: t('proj_description', 'pl').replace('{count}', `${count} ${plNoun}`),
};
---

<BaseLayout
  titleKey="page_title_projects"
  descriptionKey="page_description_projects"
  nav="projects"
>
  <div class="page">
    <header class="page-header" data-reveal>
      <h1 class="page-title gradient-text">
        <T k="proj_title" />
      </h1>
      <T en={lead.en} pl={lead.pl} as="p" class="page-lead" />
    </header>

    <ProjectFilters projects={projects} />

    <p class="count" aria-live="polite">
      <T k="projects_count" /> <strong data-count>{projects.length}</strong>
    </p>
    <ul class="grid" role="list" data-project-list>
      {projects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </ul>
    <div data-empty hidden>
      <T k="projects_empty_result" as="p" class="empty" />
    </div>
    <GetInTouch />
  </div>
  <ProjectDialog projects={projects} />
</BaseLayout>

<script>
  import '../scripts/projects';
</script>

<style>
  .count {
    margin-bottom: 1rem;
    color: var(--gray-400);
    font-size: 0.9rem;
  }
  .count strong {
    color: var(--accent-text);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 2rem;
  }
  .page :global(.empty) {
    padding: 3rem 1rem;
    color: var(--gray-400);
    text-align: center;
  }
</style>
