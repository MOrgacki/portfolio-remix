---
import { Mail } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import T from '../components/T.astro';
import AchievementCard from '../components/sections/AchievementCard.astro';
import { achievements } from '../lib/content';
import { url } from '../lib/url';
---

<BaseLayout
  titleKey="page_title_case_studies"
  descriptionKey="page_description_case_studies"
  nav="case_studies"
>
  <div class="page">
    <header class="page-header" data-reveal>
      <h1 class="page-title gradient-text">
        <T k="case_studies_title" />
      </h1>
      <T k="case_studies_subtitle" as="p" class="page-subtitle" />
      <T k="case_studies_intro" as="p" class="page-lead" />
    </header>
    <div class="cases">
      {achievements.map((item, i) => (
        <AchievementCard item={item} index={i + 1} />
      ))}
    </div>
    <section class="panel cta" data-reveal>
      <T k="case_studies_cta" as="p" class="cta-text" />
      <a class="btn btn-primary" href={url('contact/')}>
        <Mail size={20} aria-hidden="true" />
        <T k="case_get_in_touch" />
      </a>
    </section>
  </div>
</BaseLayout>

<style>
  .cases {
    margin-bottom: 3rem;
  }
  .cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }
  .cta :global(.cta-text) {
    color: var(--gray-300);
    font-size: 1.2rem;
    font-weight: 600;
  }
</style>
