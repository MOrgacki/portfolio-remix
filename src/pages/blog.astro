---
import { Check, House, PenLine } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import T from '../components/T.astro';
import { url } from '../lib/url';

const topics = ['blog_topic_1', 'blog_topic_2', 'blog_topic_3', 'blog_topic_4'] as const;
---

<BaseLayout titleKey="page_title_blog" descriptionKey="page_description_blog" nav="blog">
  <div class="page">
    <header class="page-header">
      <h1 class="page-title gradient-text">
        <T k="blog_title" />
      </h1>
      <T k="blog_description" as="p" class="page-lead" />
    </header>
    <section class="panel soon">
      <PenLine size={80} class="pen" aria-hidden="true" />
      <T k="blog_coming_soon" as="h2" class="soon-title" />
      <T k="blog_working_on" as="p" />
      <ul class="topics" role="list">
        {topics.map((k) => (
          <li>
            <Check size={20} aria-hidden="true" />
            <T k={k} />
          </li>
        ))}
      </ul>
      <T k="blog_suggestions" as="p" class="suggest" />
      <a class="btn btn-primary" href={url('')}>
        <House size={20} aria-hidden="true" />
        <T k="blog_back_home" />
      </a>
    </section>
  </div>
</BaseLayout>

<style>
  .soon {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
    color: var(--gray-300);
    background: linear-gradient(145deg, rgba(15, 23, 42, 0.9), rgba(30, 41, 59, 0.9));
  }
  .soon :global(.pen) {
    color: var(--accent-text);
    margin-bottom: 1rem;
  }
  .soon :global(.soon-title) {
    color: #fff;
    font-size: 1.6rem;
  }
  .topics {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    margin: 1rem 0 2rem;
    text-align: left;
  }
  .topics li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .topics :global(svg) {
    flex-shrink: 0;
    color: var(--accent-text);
  }
  .soon :global(.suggest) {
    color: var(--gray-400);
    font-size: 0.95rem;
    font-style: italic;
    margin-bottom: 1rem;
  }
</style>
