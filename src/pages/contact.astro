---
// The legacy /contact page repeated the home view; here it focuses on the contact channels
// and how a collaboration starts.
import { CircleCheck, FileText, Handshake, Languages, Mail } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactSection from '../components/sections/ContactSection.astro';
import T from '../components/T.astro';

const EMAIL = 'marcinorgacki@gmail.com';

const steps = [
  { icon: Mail, n: 1, titleKey: 'contact_step_1_title', descKey: 'contact_step_1_desc' },
  { icon: Handshake, n: 2, titleKey: 'contact_step_2_title', descKey: 'contact_step_2_desc' },
  { icon: FileText, n: 3, titleKey: 'contact_step_3_title', descKey: 'contact_step_3_desc' },
] as const;

const brief = ['contact_brief_1', 'contact_brief_2', 'contact_brief_3', 'contact_brief_4'] as const;
---

<BaseLayout titleKey="page_title_contact" descriptionKey="page_description_contact" nav="contact">
  <ContactSection primary />

  <div class="page">
    <section class="panel block" aria-labelledby="steps-title" data-reveal>
      <h2 class="section-title gradient-text" id="steps-title">
        <T k="contact_steps_title" />
      </h2>
      <ol class="steps" role="list">
        {steps.map(({ icon: StepIcon, n, titleKey, descKey }) => (
          <li class="step" data-reveal>
            <span class="step-number" aria-hidden="true">
              {n}
            </span>
            <StepIcon size={28} class="step-icon" aria-hidden="true" />
            <T k={titleKey} as="h3" class="step-title" />
            <T k={descKey} as="p" class="step-text" />
          </li>
        ))}
      </ol>
    </section>

    <div class="columns">
      <section class="panel" aria-labelledby="brief-title" data-reveal>
        <h2 class="col-title" id="brief-title">
          <T k="contact_brief_title" />
        </h2>
        <ul class="brief" role="list">
          {brief.map((k) => (
            <li>
              <CircleCheck size={20} class="check" aria-hidden="true" />
              <T k={k} />
            </li>
          ))}
        </ul>
        <p class="languages">
          <Languages size={20} aria-hidden="true" />
          <T k="contact_languages_note" />
        </p>
      </section>

      <section class="panel cta" aria-labelledby="cta-title" data-reveal>
        <h2 class="col-title gradient-text" id="cta-title">
          <T k="contact_cta_title" />
        </h2>
        <T k="contact_cta_text" as="p" class="cta-text" />
        <a class="email" href={`mailto:${EMAIL}`}>
          {EMAIL}
        </a>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .block {
    margin-bottom: 2rem;
  }
  .step :global(.step-title) {
    color: #fff;
    font-size: 1.1rem;
  }
  .step :global(.step-text) {
    color: var(--gray-400);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 1.25rem;
    /* An <ol>: the global reset only clears the indent of ul[role='list']. */
    padding: 0;
  }
  .step {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 2rem 1.5rem 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    text-align: center;
  }
  .step-number {
    position: absolute;
    top: -0.9rem;
    display: grid;
    place-items: center;
    width: 1.8rem;
    height: 1.8rem;
    border-radius: var(--radius-full);
    background: var(--accent-gradient);
    color: #04121c;
    font-weight: 800;
    font-size: 0.9rem;
  }
  .step :global(.step-icon) {
    color: var(--accent-text);
  }
  /* Phones: compact rows (number on the left, text beside it) instead of tall centred cards. */
  @media (max-width: 639px) {
    .steps {
      gap: 0.75rem;
    }
    .step {
      display: grid;
      grid-template-columns: 1.8rem 1fr;
      column-gap: 0.9rem;
      row-gap: 0.25rem;
      align-items: start;
      padding: 1rem;
      text-align: left;
    }
    .step-number {
      position: static;
      grid-row: 1 / span 2;
    }
    .step :global(.step-icon) {
      display: none;
    }
  }

  .columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: 2rem;
  }
  .col-title {
    margin-bottom: 1.25rem;
    color: #fff;
    font-size: clamp(1.3rem, 3vw, 1.6rem);
    font-weight: 800;
    line-height: 1.25;
  }
  .brief {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }
  .brief li,
  .languages {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    color: var(--gray-300);
  }
  .brief :global(.check) {
    flex-shrink: 0;
    margin-top: 0.15rem;
    color: rgb(var(--tech-green));
  }
  .languages {
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    color: var(--gray-400);
  }
  .languages :global(svg) {
    flex-shrink: 0;
    margin-top: 0.15rem;
  }
  .cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    text-align: center;
  }
  .cta :global(.cta-text) {
    color: var(--gray-300);
  }
  .email {
    font-size: clamp(1rem, 3.5vw, 1.25rem);
    font-weight: 700;
    overflow-wrap: anywhere;
  }
</style>
